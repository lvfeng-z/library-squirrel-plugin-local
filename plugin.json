{
  "id": "com.lvfeng.localImport",
  "name": "localImport",
  "version": "1.0.0",
  "contractVersion": 3,
  "author": "lvfeng",
  "description": "从本地路径导入文件到资源库",
  "entryFile": "local_import.exe",
  "activation": {"type": 1},
  "extensions": {
    "taskHandlers": [{"id": "main"}],
    "frontendExtensions": [
      {
        "id": "classify-panel",
        "name": "目录分类",
        "description": "扫描时交互式目录分类面板",
        "kind": "dialog",
        "content": {
          "contentType": "precompiled",
          "source": {"js": "views/classify/classify-panel.js", "css": "views/classify/style.css"}
        }
      }
    ],
    "staticResources": {
      "directories": ["views/"]
    }
  }
}
